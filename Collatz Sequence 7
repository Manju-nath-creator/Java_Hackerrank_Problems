import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
      Scanner input=new Scanner(System.in);
      int n=input.nextInt();
      int count=0;
      System.out.println("Enter a number");
        System.out.println(n);
      while(n>1){
        if(n%2==0){
          n=n/2;
        }else{
          n=(3*n)+1;
        }
        count+=1;
       
        System.out.println(n);
      
      }
       System.out.println("count:"+count);

    
    }
}
