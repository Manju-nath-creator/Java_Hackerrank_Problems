import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
      Scanner input=new Scanner(System.in);
      int num=input.nextInt();
      if (num>0){
        System.out.println("positive");
      }
      else if(num==0){
        System.out.println("zero");
      }else{
        System.out.println("negative");
      }
    }
}
