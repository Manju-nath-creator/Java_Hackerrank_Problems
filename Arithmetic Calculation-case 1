import java.util.Scanner;

public class Solution {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        int num = input.nextInt();
        int num2 = input.nextInt();
        char ch = input.next().charAt(0);

        double result;

        switch (ch) {
            case '+':
                result = num + num2;
                System.out.printf("Addition of two number is %.1f%n", result);
                break;

            case '-':
                result = num - num2;
                System.out.printf("Subtraction of two number is %.1f%n", result);
                break;

            case '*':
                result = num * num2;
                System.out.printf("Multiplication of two number is %.1f%n", result);
                break;

            case '/':
                if (num2 != 0) {
                    result = (double) num / num2;
                    System.out.printf("Division of two number is %.1f%n", result);
                } else {
                    System.out.println("Error: Division by zero!");
                }
                break;

            case '%':
                if (num2 != 0) {
                    result = num % num2;
                    System.out.printf("Modulus of two number is %.1f%n", result);
                } else {
                    System.out.println("Error: Modulus by zero!");
                }
                break;

            default:
                System.out.println("Invalid Input");
        }
    }
}
