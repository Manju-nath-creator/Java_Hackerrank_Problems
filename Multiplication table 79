import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
      Scanner input=new Scanner(System.in);
      int n=input.nextInt();
      if (n < 1 || n > 9) {
        System.out.println("Invalid Input");
    return;
}

      for(int i=1;i<=n;i++){
        System.out.println(n+" * "+i+" = "+(n*i));
      }
    }
}
