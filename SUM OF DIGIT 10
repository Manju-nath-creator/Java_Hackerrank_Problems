import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
      Scanner input=new Scanner(System.in);
      int n=input.nextInt();
      int sum=0;
      if(n<99){
        System.out.println("Invalid Input");
      }else{
        while(n>0){
          int last_digit=n%10;
          sum+=last_digit;
          n=n/10;
      }
      System.out.println("Sum of digit is "+sum);
      }
    }
}
